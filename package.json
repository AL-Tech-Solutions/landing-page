		"favicon": "node tools/generate-favicon.mjs",
		"logos": "node tools/fetch-official-logos.mjs"
	},
	"dependencies": {
		"framer-motion": "^12.43.0",
		"github-slugger": "^2.0.0",
		"gray-matter": "^4.0.3",
		"next": "^16.3.4",
		"next-mdx-remote": "^6.0.0",
		"next-themes": "^0.4.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"rehype-slug": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"simple-icons": "^16.27.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@playwright/test": "^1.61.1",
		"@types/mdx": "^2.0.14",
		"@types/node": "^22.0.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"autoprefixer": "^10.5.2",
		"cspell": "^9.8.0",
		"eslint": "^9",
		"eslint-config-next": "^16.3.3",
		"eslint-config-prettier": "^10.1.8",
		"knip": "^6.26.0",
		"postcss": "^8",
		"prettier": "^3.9.6",
		"serve": "^14.2.6",
		"sharp": "^0.35.3",
		"tailwindcss": "^3.4.19",
		"typescript": "^5",
		"vitest": "^5.0.0"
	}
