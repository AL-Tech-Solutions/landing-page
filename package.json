{
	"name": "aboutme",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"spell": "cspell --no-progress 'src/**/*.{ts,tsx}' 'content/**/*.{md,mdx}' '*.md'",
